name: Build APK
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.7"
      - name: Unpack and build
        run: |
          for z in *.zip; do [ -f "$z" ] && unzip -q -o "$z"; done
          F=$(find . -name settings.gradle.kts -not -path "./.git/*" | head -n 1)
          echo "Found: $F"
          cd "$(dirname "$F")"
          gradle assembleDebug --no-daemon
      - uses: actions/upload-artifact@v4
        with:
          name: NoAdsVpn-apk
          path: "**/app-debug.apk"
